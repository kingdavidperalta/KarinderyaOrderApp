@model KarinderyaOrderApp.ViewModels.Order.CreateOrderViewModel

@{
    ViewData["Title"] = "New Order";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">New Order</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to orders</a>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form asp-action="Create" method="post" data-order-form>
    <div class="row g-4">

        <!-- LEFT: FOOD CARDS -->
        <div class="col-lg-8">
            @if (!Model.Lines.Any())
            {
                <div class="alert alert-secondary mb-0">No foods are available right now.</div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        var line = Model.Lines[i];
                        <div class="col">
                            <div class="card h-100 shadow-sm"
                                 data-food-card
                                 data-food-id="@line.FoodId"
                                 data-name="@line.Name"
                                 data-price="@line.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-stock="@line.QuantityInStock">
                                <div class="card-body d-flex flex-column">
                                    <h2 class="h6 card-title">@line.Name</h2>
                                    <p class="fw-semibold mb-1">@("₱" + line.Price.ToString("N2"))</p>
                                    <p class="text-muted small mb-3">@line.QuantityInStock available</p>
                                    <button type="button" class="btn btn-primary btn-sm mt-auto" data-add>Add to cart</button>
                                </div>

                                <input type="hidden" asp-for="Lines[i].FoodId" />
                                <input type="hidden" asp-for="Lines[i].Quantity" data-qty-for="@line.FoodId" />
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <div class="col-lg-4">
            <div class="card shadow-sm position-sticky" style="top: 1rem;">
                <div class="card-header bg-white fw-semibold">Order Summary</div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody data-cart-body></tbody>
                    </table>
                </div>

                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between fs-5 mb-3">
                        <span>Total</span>
                        <strong>₱<span data-order-total>0.00</span></strong>
                    </div>
                    <button type="submit" class="btn btn-primary w-100" data-submit disabled>Place Order</button>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- One cart row (cloned by the script) -->
<template data-cart-row>
    <tr>
        <td class="fw-semibold" data-row-name></td>
        <td class="text-center text-nowrap">
            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-dec aria-label="Decrease">−</button>
            <span class="mx-2" data-row-qty></span>
            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-inc aria-label="Increase">+</button>
        </td>
        <td class="text-end" data-row-total></td>
        <td class="text-end">
            <button type="button" class="btn-close" aria-label="Remove" data-remove></button>
        </td>
    </tr>
</template>

<template data-cart-empty>
    <tr>
        <td colspan="4" class="text-center text-muted py-4">Your cart is empty.<br />Click "Add to cart" on a food.</td>
    </tr>
</template>

@section Scripts {
    <script>
       
    </script>
}
